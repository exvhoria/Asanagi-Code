#!/data/data/com.termux/files/usr/bin/bash
# Asanagi Unlimited Gateway manager (opencode2api on 127.0.0.1:8080)
BASE_DIR="$HOME/.opencode-proxy"
BIN="$BASE_DIR/bin/opencode2api"
CONFIG="$BASE_DIR/config.json"
PID_FILE="$BASE_DIR/proxy.pid"
LOG_FILE="$BASE_DIR/proxy.log"
SPAWNER="$BASE_DIR/daemon_spawn.py"
API_URL="http://127.0.0.1:8123"
API_KEY="local-test-key"

get_pid() {
    if [ -f "$PID_FILE" ]; then
        local pid; pid=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then echo "$pid"; return 0; fi
    fi
    local found; found=$(pgrep -f "$BIN" | head -n 1)
    if [ -n "$found" ]; then echo "$found" > "$PID_FILE"; echo "$found"; return 0; fi
    return 1
}

kill_all_proxies() {
    echo "[*] Forcefully terminating all gateway engines and port listeners..."
    pkill -9 -f "opencode2api" 2>/dev/null || true
    pkill -9 -f "openrouter-bridge" 2>/dev/null || true
    pkill -9 -f "bridge.py" 2>/dev/null || true
    pkill -9 -f "daemon_spawn.py" 2>/dev/null || true
    local port_pids
    port_pids=$(lsof -ti :8080,8081,8085 2>/dev/null || fuser 8080/tcp 8081/tcp 8085/tcp 2>/dev/null || true)
    [ -n "$port_pids" ] && kill -9 $port_pids 2>/dev/null || true
    rm -f "$PID_FILE" "$HOME/.local/state/openrouter-bridge/bridge.pid" 2>/dev/null || true
    # Self-heal corrupted OpenCode SQLite database
    python3 - << 'PY' 2>/dev/null || true
import os, sqlite3
db = os.path.expanduser("~/.local/share/opencode/opencode.db")
if os.path.isfile(db):
    try:
        conn = sqlite3.connect(db, timeout=1.0)
        conn.cursor().execute("SELECT count(*) FROM session;")
        conn.close()
    except Exception:
        try:
            os.rename(db, db + ".corrupted")
            for ext in ["-wal", "-shm"]:
                p = db + ext
                if os.path.exists(p): os.remove(p)
        except Exception:
            pass
PY
    sleep 0.5
    echo "[+] All gateway processes and port bindings terminated."
}

start_proxy() {
    if get_pid >/dev/null 2>&1; then
        if curl -s --max-time 1.5 "$API_URL/healthz" >/dev/null 2>&1; then
            echo "[*] Gateway already running (PID: $(get_pid))"; return 0
        else
            echo "[!] Dead or unresponsive gateway (PID: $(get_pid)). Purging..."
            kill_all_proxies
        fi
    fi
    pkill -9 -f "opencode2api" 2>/dev/null || true
    rm -f "$PID_FILE"; sleep 0.5
    if [ ! -s "$PREFIX/etc/resolv.conf" ]; then
        mkdir -p "$PREFIX/etc"
        echo "nameserver 1.1.1.1" > "$PREFIX/etc/resolv.conf"
        echo "nameserver 8.8.8.8" >> "$PREFIX/etc/resolv.conf"
    fi
    if [ -f "$PREFIX/etc/tls/cert.pem" ]; then
        mkdir -p "$PREFIX/etc/ssl/certs" "$PREFIX/glibc/etc/ssl/certs" "$PREFIX/glibc/etc/ca-certificates" 2>/dev/null || true
        ln -sf "$PREFIX/etc/tls/cert.pem" "$PREFIX/etc/ssl/certs/ca-certificates.crt" 2>/dev/null || true
        ln -sf "$PREFIX/etc/tls/cert.pem" "$PREFIX/glibc/etc/ssl/cert.pem" 2>/dev/null || true
        ln -sf "$PREFIX/etc/tls/cert.pem" "$PREFIX/glibc/etc/ssl/certs/ca-certificates.crt" 2>/dev/null || true
        ln -sf "$PREFIX/etc/tls/cert.pem" "$PREFIX/glibc/etc/ca-certificates/cacert.pem" 2>/dev/null || true
    fi
    export SSL_CERT_FILE="$PREFIX/etc/tls/cert.pem"
    export SSL_CERT_DIR="$PREFIX/etc/ssl/certs"
    echo "[*] Starting gateway daemon on 127.0.0.1:8080 (WARP pool)..."
    local runner=()
    if command -v termux-chroot >/dev/null 2>&1; then runner=(termux-chroot); fi
    python3 "$SPAWNER" "$PID_FILE" "$LOG_FILE" "${runner[@]}" "$BIN" -config "$CONFIG"
    sleep 2
    if ! get_pid >/dev/null 2>&1; then
        # fallback: daemon_spawn.py bisa gagal di proot (ptrace) — start langsung
        echo "[*] Spawner failed, starting directly..."
        ( cd "$BASE_DIR" && nohup "$BIN" -config "$CONFIG" >> "$LOG_FILE" 2>&1 & echo $! > "$PID_FILE" )
        sleep 2
    fi
    if get_pid >/dev/null 2>&1; then
        echo "[+] Gateway started successfully (PID: $(get_pid))"
    else
        echo "[-] Failed to start gateway. Last log lines:"
        [ -f "$LOG_FILE" ] && tail -n 8 "$LOG_FILE"
        exit 1
    fi
}

status_proxy() {
    local pid; pid=$(get_pid 2>/dev/null) || true
    if [ -n "$pid" ]; then
        echo "[+] Gateway: RUNNING (PID: $pid)"
        local health; health=$(curl -s --max-time 2 "$API_URL/healthz" 2>/dev/null)
        if [ -n "$health" ]; then
            echo "    WARP      : $(echo "$health" | jq -r '.warp | "\(.status) (active: \(.active), standby: \(.standby))"' 2>/dev/null)"
            echo "    Models    : $(echo "$health" | jq -r '.models.exposed // 0' 2>/dev/null) exposed"
            echo "    API Base  : $API_URL/v1"
            echo "    Dashboard : http://127.0.0.1:8081"
        else
            echo "    Health    : initializing or unreachable"
        fi
    else
        echo "[-] Gateway: STOPPED"
    fi
}

test_chat() {
    local model="${1:-glm-5.3-flash-free}"
    echo "[*] Streaming test prompt to '$model'..."
    curl -s -N -H "Authorization: Bearer $API_KEY" -H "Content-Type: application/json" \
         -d "{\"model\":\"$model\",\"messages\":[{\"role\":\"user\",\"content\":\"Ping test.\"}],\"stream\":true}" \
         "$API_URL/v1/chat/completions" | while read -r line; do
        if [[ "$line" =~ ^data:\ (.*) ]]; then
            local json_data="${BASH_REMATCH[1]}"
            [ "$json_data" = "[DONE]" ] && { echo -e "\n[+] Stream completed."; break; }
            local content; content=$(echo "$json_data" | jq -r '.choices[0].delta.content // empty' 2>/dev/null)
            [ -n "$content" ] && printf '%s' "$content"
        fi
    done
    echo ""
}

case "$1" in
    start)          start_proxy ;;
    stop)           kill_all_proxies ;;
    kill|kill-all)  kill_all_proxies ;;
    restart)        kill_all_proxies; sleep 1; start_proxy ;;
    status)         status_proxy ;;
    test)           test_chat "$2" ;;
    logs)           tail -n 35 "$LOG_FILE" 2>/dev/null || echo "[-] No log file." ;;
    *) echo "Usage: opencode-proxy {start|stop|kill|restart|status|test [model]|logs}"; exit 1 ;;
esac
