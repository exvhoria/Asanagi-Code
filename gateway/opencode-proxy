#!/data/data/com.termux/files/usr/bin/bash
# Manage only the Asanagi gateway, never other API instances or OpenCode's DB.
set -u
unset LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT
PREFIX=/data/data/com.termux/files/usr
BASE_DIR=/data/data/com.termux/files/home/.opencode-proxy
BIN="$BASE_DIR/bin/opencode2api"
CONFIG="$BASE_DIR/config.json"
PID_FILE="$BASE_DIR/proxy.pid"
LOG_FILE="$BASE_DIR/proxy.log"
API_URL=http://127.0.0.1:8123
API_KEY=local-test-key
WAIT_SECONDS="${ASANAGI_GATEWAY_WAIT:-120}"

die() { printf '[-] %s\n' "$*" >&2; exit 1; }
[[ "$WAIT_SECONDS" =~ ^[0-9]+$ ]] || die "ASANAGI_GATEWAY_WAIT must be a number."

is_gateway_pid() {
    local pid="$1" cmd cwd arg found=0
    local -a args=()
    [[ "$pid" =~ ^[0-9]+$ && "$pid" != "$$" ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    [ -r "/proc/$pid/cmdline" ] || return 1
    mapfile -d '' -t args < "/proc/$pid/cmdline" 2>/dev/null || return 1
    cmd="${args[0]:-}"
    case "$cmd" in
        "$BIN") ;;
        ./bin/opencode2api|bin/opencode2api)
            cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null) || return 1
            [ "$cwd" = "$BASE_DIR" ] || return 1 ;;
        *) return 1 ;;
    esac
    for arg in "${args[@]:1}"; do
        if [ "$found" = 1 ]; then
            case "$arg" in
                "$CONFIG") return 0 ;;
                config.json|./config.json)
                    cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null) || return 1
                    [ "$cwd" = "$BASE_DIR" ]; return $? ;;
                *) return 1 ;;
            esac
        fi
        [ "$arg" != -config ] || found=1
    done
    return 1
}

get_pid() {
    local pid path
    if [ -f "$PID_FILE" ]; then
        read -r pid < "$PID_FILE" || pid=""
        if is_gateway_pid "$pid"; then printf '%s\n' "$pid"; return 0; fi
    fi
    for path in /proc/[0-9]*/cmdline; do
        pid="${path#/proc/}"; pid="${pid%/cmdline}"
        if is_gateway_pid "$pid"; then
            printf '%s\n' "$pid" > "$PID_FILE"
            printf '%s\n' "$pid"; return 0
        fi
    done
    return 1
}

gateway_ready() {
    curl --noproxy '*' -fsS --connect-timeout 2 --max-time 3 "$API_URL/healthz" 2>/dev/null |
        jq -e '.ready == true and .status == "ok"' >/dev/null 2>&1
}

stop_proxy() {
    local pid i
    while pid=$(get_pid); do
        printf '[*] Stopping Asanagi gateway (PID: %s)...\n' "$pid"
        is_gateway_pid "$pid" && kill -TERM "$pid" 2>/dev/null || true
        for ((i=0; i<5; i++)); do
            is_gateway_pid "$pid" || break
            sleep 1
        done
        is_gateway_pid "$pid" && kill -KILL "$pid" 2>/dev/null || true
        sleep 0.2
    done
    rm -f "$PID_FILE"
    printf '[+] Asanagi gateway stopped; other services were not targeted.\n'
}

start_proxy() {
    local pid deadline
    if gateway_ready; then
        printf '[+] Asanagi gateway already ready: %s\n' "$API_URL"
        return 0
    fi
    [ -x "$BIN" ] || die "Gateway engine missing: $BIN"
    [ -r "$CONFIG" ] || die "Gateway configuration missing: $CONFIG"
    jq -e '.listen == "127.0.0.1:8123"' "$CONFIG" >/dev/null ||
        die "Gateway config must listen on 127.0.0.1:8123 (not the old 8080 port)."
    if pid=$(get_pid); then
        printf '[*] Waiting for existing Asanagi gateway (PID: %s)...\n' "$pid"
    else
        printf '[*] Starting Asanagi gateway on 127.0.0.1:8123 (direct, no PRoot)...\n'
        export SSL_CERT_FILE="$PREFIX/etc/tls/cert.pem"
        export SSL_CERT_DIR="$PREFIX/etc/ssl/certs"
        export GOMEMLIMIT="${GOMEMLIMIT:-160MiB}"
        ( cd "$BASE_DIR" && exec nohup "$BIN" -config "$CONFIG" ) \
            </dev/null >> "$LOG_FILE" 2>&1 9>&- &
        pid=$!
        printf '%s\n' "$pid" > "$PID_FILE"
    fi
    deadline=$((SECONDS + WAIT_SECONDS))
    while [ "$SECONDS" -lt "$deadline" ]; do
        if gateway_ready; then
            printf '[+] Asanagi gateway ready: %s\n' "$API_URL"
            return 0
        fi
        if ! is_gateway_pid "$pid"; then
            printf '[-] Gateway exited before becoming ready. Last log lines:\n' >&2
            tail -n 12 "$LOG_FILE" >&2
            return 1
        fi
        sleep 2
    done
    printf '[-] Gateway did not become ready in %ss. See: %s\n' "$WAIT_SECONDS" "$LOG_FILE" >&2
    tail -n 12 "$LOG_FILE" >&2
    return 1
}

status_proxy() {
    local pid
    printf '    Config: %s\n    API: %s/v1\n' "$CONFIG" "$API_URL"
    if gateway_ready; then
        printf '[+] Asanagi gateway READY\n'
        return 0
    fi
    if pid=$(get_pid); then
        printf '[!] Asanagi gateway running but not ready (PID: %s)\n' "$pid"
    else
        printf '[-] Asanagi gateway STOPPED\n'
    fi
    return 1
}

case "${1:-}" in
    start|stop|kill|kill-all|restart)
        mkdir -p "$BASE_DIR" || die "Cannot access $BASE_DIR"
        command -v flock >/dev/null || die "flock missing. In Termux run: pkg install util-linux"
        exec 9>"$BASE_DIR/manager.lock"
        flock -w "$((WAIT_SECONDS + 10))" 9 || die "Another gateway operation is still running."
        case "$1" in
            start) start_proxy ;;
            stop|kill|kill-all) stop_proxy ;;
            restart) stop_proxy; start_proxy ;;
        esac ;;
    status) status_proxy ;;
    logs) tail -n 35 "$LOG_FILE" ;;
    test)
        payload=$(jq -nc --arg m "${2:-glm-5.3-flash-free}" \
            '{model:$m,messages:[{role:"user",content:"Say ok."}],max_tokens:100,stream:true}')
        curl --noproxy '*' -fsS -N --connect-timeout 3 --max-time 120 \
            -H "Authorization: Bearer $API_KEY" -H 'Content-Type: application/json' \
            -d "$payload" "$API_URL/v1/chat/completions" ;;
    *) printf 'Usage: opencode-proxy {start|stop|kill|restart|status|test [model]|logs}\n'; exit 1 ;;
esac
