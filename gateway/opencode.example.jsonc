{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "provider": {
    "asanagi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Asanagi Unlimited",
      "options": {
        "baseURL": "http://127.0.0.1:8123/v1",
        "apiKey": "local-test-key"
      },
      "models": {
        "glm-5.3-flash-free": {
          "name": "GLM 5.3 Flash (Unlimited)",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "limit": {
            "context": 200000,
            "output": 32000
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "deepseek-v4.1-flash-free": {
          "name": "DeepSeek V4.1 Flash (Unlimited)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        },
