{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "asanagi/deepseek-v4.1-flash-free",
  "permission": {
    "*": "allow",
    "bash": "allow",
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "websearch": "allow"
  },
  "provider": {
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "openrouter",
      "options": {
        "baseURL": "http://127.0.0.1:8085/v1"
      },
      "models": {
        "anthropic/claude-3.7-sonnet": {},
        "anthropic/claude-3.5-sonnet": {},
        "openai/gpt-4o": {},
        "openai/o3-mini": {},
        "deepseek/deepseek-chat": {},
        "google/gemini-2.5-pro": {},
        "meta-llama/llama-3.3-70b-instruct": {}
      }
    },
    "asanagi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Asanagi Unlimited",
      "options": {
        "baseURL": "http://127.0.0.1:8123/v1",
        "apiKey": "local-test-key"
      },
      "models": {
        "deepseek-v4.1-flash-free": {
          "name": "DeepSeek V4.1 Flash (Unlimited)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        },
        "nemotron-3.5-lightning-free": {
          "name": "Nemotron 3.5 Lightning (Unlimited)",
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 32000
          }
        },
        "nemotron-3.5-super-vl-free": {
          "name": "Nemotron 3.5 Super VL (Unlimited)",
          "tool_call": true,
          "attachment": true,
          "limit": {
            "context": 1048576,
            "output": 32000
          }
        },
        "flint-40b-free": {
          "name": "Flint 40B (Unlimited)",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 32000
          }
        },
        "big-pickle": {
          "name": "Big Pickle (Unlimited)",
          "tool_call": true,
          "limit": {
            "context": 200000,
            "output": 32000
          }
        },
        "beam-free": {
          "name": "Beam (Unlimited)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 32000
          }
        },
        "iceman-free": {
          "name": "Iceman (Unlimited)",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 32000
          }
        },
        "inkling-2-small-free": {
          "name": "Inkling 2 Small (Unlimited)",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 32000
          }
        },
        "longcat-2.5-free": {
          "name": "LongCat 2.5 (Unlimited)",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 32000
          }
        },
        "mimo-v2.6-flash-free": {
          "name": "MiMo v2.6 Flash (Unlimited)",
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 32000
          }
        },
        "hy4-flash-free": {
          "name": "HY4 Flash (Unlimited)",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        }
      }
    }
  }
}