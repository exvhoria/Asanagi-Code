# Copy this file to .env and fill in the real values: cp .env.example .env

# Bot token: Discord Developer Portal -> Your App -> Bot -> Reset Token
DISCORD_TOKEN=your-bot-token-here

# Application ID: Discord Developer Portal -> Your App -> General Information
CLIENT_ID=your-application-id-here

# Optional: a specific server (guild) ID to register commands to for instant testing.
# Leave empty to register commands globally (can take up to 1 hour to propagate).
GUILD_ID=

# Optional: default per-user per-command cooldown in seconds (default: 3, 0 disables).
COMMAND_COOLDOWN_SECONDS=3
